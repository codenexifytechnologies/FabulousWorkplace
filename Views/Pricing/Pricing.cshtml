        <div class="row">
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon.png" alt="work-icon">
