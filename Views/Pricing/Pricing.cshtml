                        </div>
                        <h3 class="work-title">Application Submission</h3>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon2.png" alt="work-icon">
                            <span class="work-number">02</span>
                        </div>
                        <h3 class="work-title">Workplace Assessment</h3>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon3.png" alt="work-icon">
                            <span class="work-number">03</span>
                        </div>
                        <h3 class="work-title">Evaluation & Review<</h3>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box style-foure">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon4.png" alt="work-icon">
                            <span class="work-number">04</span>
                        </div>
                        <h3 class="work-title">Certification Awarded</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!--==================================================-->
<!-- End roadly work Area-->
