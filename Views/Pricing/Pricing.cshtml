@{
    ViewBag.Title = "Fabulous Workplace Pricing | Affordable Certification Plans";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section MetaTags {
    <meta name="description" content="Explore Fabulous Workplace's transparent and affordable pricing plans for workplace certification, culture assessment, and branding recognition. Build a better workplace today!">
    <meta name="keywords" content="workplace certification pricing,culture assessment cost,branding recognition plans,affordable workplace certification,employee engagement pricing">
    <link rel="canonical" href="https://fabulousworkplace.in/Workplace-Certificate-Pricing" />

}

<!--==================================================-->
<!-- Start roadly Breadcumb Area -->
<!--==================================================-->
<div class="breadcumb-area d-flex style_two">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <div class="breadcumb-title">
                        <h4>Pricing Plan</h4>
                    </div>
                    <ul>
                        <li><a href="@Url.Action("Index", "Index")">Home <span>/</span></a></li>
                        <li class="breadcumb-intext">Pricing Plan</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="breadcumb-shape">
            <img src="~/assets/images/inner-img/breadcumb-dot.png" alt="dot">
        </div>
    </div>
</div>
<!--==================================================-->
<!-- End roadly Breadcumb Area -->
<!--==================================================-->
<!--==================================================-->
<!-- start roadly pricing Area -->
<!--==================================================-->
<div class="pricing-area inner-style">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section_title text-center">
                    <h4>pricing plan</h4>
                    <h1>Roadly Pricing Plans</h1>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6">
                <div class="single-pricing-box">
                    <div class="pricing-icon">
                        <span><img src="~/assets/images/inner-img/pricing-icon1.png" alt="icon"></span>
                    </div>
                    <div class="pricing-title">
                        <h2>basick Plan</h2>
                    </div>
                    <div class="pricing-body">
                        <div class="pricing-list">
                            <ul>
                                <li>Workplace eligibility review</li>
                                <li>Culture overview assessment</li>
                                <li>Certification validity badge</li>
                                <li>Standard support</li>
                                <li>Certification listing</li>
                            </ul>
                        </div>
                        <div class="pricing-rate">
                            <h1>$39.99</h1>
                        </div>
                    </div>
                    <div class="pricing-button">
                        <a href="@Url.Action("Contact", "Contact")">Get Start Now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-pricing-box">
                    <div class="pricing-icon">
                        <span><img src="~/assets/images/inner-img/pricing-icon2.png" alt="icon"></span>
                    </div>
                    <div class="pricing-title">
                        <h2>advance plan</h2>
                    </div>
                    <div class="pricing-body">
                        <div class="pricing-list">
                            <ul>
                                <li>Full workplace assessment</li>
                                <li>Employee experience evaluation</li>
                                <li>Certification badge & certificate</li>
                                <li>Priority support</li>
                                <li>Employer branding assets</li>
                            </ul>
                        </div>
                        <div class="pricing-rate">
                            <h1>$49.99</h1>
                        </div>
                    </div>
                    <div class="pricing-button">
                        <a href="@Url.Action("Contact", "Contact")">Get Start Now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-pricing-box">
                    <div class="pricing-icon">
                        <span><img src="~/assets/images/inner-img/pricing-icon3.png" alt="icon"></span>
                    </div>
                    <div class="pricing-title">
                        <h2>premium plan</h2>
                    </div>
                    <div class="pricing-body">
                        <div class="pricing-list">
                            <ul>
                                <li>Comprehensive culture evaluation</li>
                                <li>Leadership & people practices</li>
                                <li>Premium certification badge</li>
                                <li>Dedicated support</li>
                                <li>Featured recognition listing</li>
                            </ul>
                        </div>
                        <div class="pricing-rate">
                            <h1>$59.99</h1>
                        </div>
                    </div>
                    <div class="pricing-button">
                        <a href="@Url.Action("Contact", "Contact")">Get Start Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!--==================================================-->
<!-- End roadly pricing Area -->
<!--==================================================-->
<!--==================================================-->
<!-- Start roadly work Area Csss-->
<!--==================================================-->
