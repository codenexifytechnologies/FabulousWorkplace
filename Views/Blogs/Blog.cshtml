@model FabulousWorkplaceWebsite.Models.BlogManagement
@{
    ViewBag.Title = Model.WebsiteTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section MetaTags {
    <meta name="description" content="@Model.WebsiteDescription">
    <meta name="keywords" content="@Model.WebsiteKeyword">
    <link rel="canonical" href="https://fabulousworkplace.in/@Model.WebsiteURL" />

}
<div class="breadcumb-area d-flex style_two">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <div class="breadcumb-title">
                        <h4>@Model.BlogTitle</h4>
                    </div>
                    <ul>
                        <li><a href="@Url.Action("Index", "Index")">Home <span>/</span></a></li>
                        <li class="breadcumb-intext">Blog Details</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="breadcumb-shape">
            <img src="~/assets/images/inner-img/breadcumb-dot.png" alt="dot" />
        </div>
    </div>
</div>

<section class="blog_details_area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="blog-details-thumb">
                    <img src="@Model.ImagePath1"
                         alt="thumb" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-8">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="blog-details-content">
                            <p class="blog-details-desc">
                                @Html.Raw(Model.BlogDiscription)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="widget-sidber-contact-box">
                            <div class="widget-sidber-contact">
                                <img src="assets/images/inner-img/sidber-cont-icon.png"
                                     alt="icon" />
                            </div>
                            <p class="widget-sidber-contact-text">Call Us Anytime</p>
                            <h3 class="widget-sidber-contact-number">+91 908-272-8804</h3>
                            <span class="widget-sidber-contact-gmail"><i class="bi bi-envelope-fill"></i>fabulousworkplace@gmail.com</span>
                            <div class="widget-sidber-contact-btn">
                                <a href="@Url.Action("Contact", "Contact")">
                                    Contact Us <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

