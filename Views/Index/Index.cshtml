<!-- Start roadly service Area-->
<!--==================================================-->
<section class="service_area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section_title text-center">
                    <h4>our services</h4>
                    <h1>Our Awesome Services</h1>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single_service_box">
                    <div class="service_content">
                        <h3 class="service_title">Workplace Certification</h3>
                        <p class="service_des">
                            Comprehensive assessment of workplace culture, employee engagement practices to certify organizations as Fabulous Workplaces.
                        </p>
                        <div class="service-btn">
                            <a href="@Url.Action("Contact", "Contact")">Contact Us <i class="flaticon flaticon-right-arrow"></i></a>
                        </div>
                    </div>
                    <div class="service_thumb">
                        <img src="~/assets/images/home_one/service-thumb.png" alt="service-thumb">
                        <div class="service_icon">
                            <img src="~/assets/images/home_one/work-icon.png" alt="service-icon">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single_service_box">
                    <div class="service_content">
                        <h3 class="service_title">Culture Assessment</h3>
                        <p class="service_des">
                            In-depth evaluation of leadership, trust, inclusion, and employee experience using structured frameworks and insights......
                        </p>
                        <div class="service-btn">
                            <a href="@Url.Action("Contact", "Contact")">Contact Us <i class="flaticon flaticon-right-arrow"></i></a>
                        </div>
                    </div>
                    <div class="service_thumb">
                        <img src="~/assets/images/home_one/service-thumb2.png" alt="service-thumb">
                        <div class="service_icon">
                            <img src="~/assets/images/home_one/work-icon2.png" " alt="service-icon">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single_service_box">
                    <div class="service_content">
                        <h3 class="service_title">Branding Recognition</h3>
                        <p class="service_des">
                            Recognition badges and certification assets that help organizations showcase their commitment to a positive workplace culture.
                        </p>
                        <div class="service-btn">
                            <a href="@Url.Action("Contact", "Contact")">Contact Us <i class="flaticon flaticon-right-arrow"></i></a>
                        </div>
                    </div>
                    <div class="service_thumb">
                        <img src="/assets/images/home_one/service-thumb3.png" alt="service-thumb">
                        <div class="service_icon">
                            <img src="~/assets/images/home_one/work-icon3.png" alt="service-icon">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
