<!-- Start roadly Blog Area -->
<!--==================================================-->
@if (ViewBag.lstBlogManagement != null && (ViewBag.lstBlogManagement as List<FabulousWorkplaceWebsite.Models.BlogManagement>).Count > 0)
{
    <section class="blog_area">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section_title text-center">
                        <h4>recent blog</h4>
                        <h1>Read our Blogs</h1>
                    </div>
                </div>
            </div>
            <div class="row">
                @{
                    var lstBlogManagement = ViewBag.lstBlogManagement as List<FabulousWorkplaceWebsite.Models.BlogManagement>;
                    var _Count = lstBlogManagement.Count > 3 ? 3 : lstBlogManagement.Count;
                    for (int i = 0; i < _Count; i++)
                    {
                        <div class="col-xl-4 col-lg-6 col-md-6">
                            <div class="single-blog-box">
                                <div class="single-blog-thumb">
                                    <img src="@lstBlogManagement[i].ImagePath1" alt="thumb">
                                </div>
                                <div class="blog-content">
                                    <div class="blog-title">
                                        <h3><a href="@Url.Action("Blog", "Blogs", new { id = lstBlogManagement[i].Id })">@lstBlogManagement[i].BlogTitle</a></h3>
                                    </div>
                                    <p class="blog-description">
                                        @lstBlogManagement[i].BlogOneLinerDiscription
                                    </p>
                                    <div class="blog-btn">
                                        <a href="@Url.Action("Blog", "Blogs", new { id = lstBlogManagement[i].Id })">Read More<i class="flaticon flaticon-right-arrow"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}
