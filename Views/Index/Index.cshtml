
@{
    ViewBag.Title = "Employee Engagement & Workplace Culture Platform";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section MetaTags {
    <meta name="description" content="Fabulous Workplace helps organizations build strong culture through employee engagement, surveys, feedback, and performance insights for better workplaces.">
    <meta name="keywords" content="Best work place culture,great place to work,Workplace evaluation,Employee engagement solutions,Workplace recognition programs, Workplace assessment services">
    <link rel="canonical" href="https://fabulousworkplace.in" />
}

<!--==================================================-->
<!-- Start roadly Hero Area Area -->
<!--==================================================-->
<section class="hero_area d-flex align-items-center">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <!-- hero content -->
                <div class="hero_content">
                    <h1>How Great Companies<br> <span>Build Fabulous</span><br>Workplaces</h1>
                    <p>
                        We evaluate each organization with care, using trusted assessment methods to recognize workplaces that foster positive culture, employee engagement, and people-first practices.
                    </p>
                    <!-- slider button -->
                    <div class="slider_button">
                        <div class="banner_btn roadly_btn">
                            <a href="@Url.Action("Contact", "Contact")">Get Certified  <i class="flaticon flaticon-right-arrow"></i><span></span></a>
                        </div>
                    </div>
                    <div class="hero-video-icon">
                        <a class="video-vemo-icon venobox vbox-item" data-vbtype="youtube" data-autoplay="true" href="#"><i class="bi bi-play"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
            </div>
        </div>
    </div>
</section>
<!--==================================================-->
<!-- End roadly Hero  Area -->
<!--==================================================-->
<!--==================================================-->
<!-- Start roadly Counter Area-->
<!--==================================================-->
