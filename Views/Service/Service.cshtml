@{
    ViewBag.Title = "Fabulous Workplace Services | Certified Workplace Excellence";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section MetaTags {
    <meta name="description" content="Discover Fabulous Workplace's trusted services, including workplace certification, culture assessment, and branding recognition. Build a positive, high-performing workplace culture with our expert evaluations and certifications.">
    <meta name="keywords" content="workplace certification,culture assessment,branding recognition,employee engagement,positive workplace culture,">
    <link rel="canonical" href="https://fabulousworkplace.in/workplace-certification-Service" />
}

<!--==================================================-->
<!-- Start roadly Breadcumb Area -->
<!--==================================================-->
<div class="breadcumb-area d-flex style_two">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <div class="breadcumb-title">
                        <h4>Services</h4>
                    </div>
                    <ul>
                        <li><a href="@Url.Action("Index", "Index")">Home <span>/</span></a></li>
                        <li class="breadcumb-intext">Services</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="breadcumb-shape">
            <img src="~/assets/images/inner-img/breadcumb-dot.png" alt="dot">
        </div>
    </div>
</div>
<!--==================================================-->
<!-- End roadly Breadcumb Area -->
<!--==================================================-->
<!--==================================================-->
<!-- Start roadly service section inner style -->
<!--==================================================-->
<div class="service-section inner-style">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section_title text-left">
                    <h4>our services</h4>
                    <h1>Awesome Services</h1>
                    <div class="section-btn">
                        <a href="@Url.Action("Contact", "Contact")">Contact Us<i class="flaticon flaticon-right-arrow"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xl-3 col-lg-4">
                <div class="service-single-box">
                    <div class="service-icon">
                        <img src="~/assets/images/inner-img/serv-icon1.png" alt="icon">
                    </div>
                    <div class="service-content">
                        <h3>Workplace Certification</h3>
                        <p>
                            Independent certification that recognizes organizations committed to positive workplace culture, ethical leadership, and people-first practices.
                        </p>
                    </div>
                    <div class="service-btn">
                        <a href="@Url.Action("Contact", "Contact")">Contact Us<i class="flaticon flaticon-right-arrow"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4">
                <div class="service-single-box two">
                    <div class="service-icon">
                        <img src="~/assets/images/inner-img/serv-icon2.png" alt="icon">
                    </div>
                    <div class="service-content">
                        <h3>Culture Assessment</h3>
                        <p>
                            Structured evaluation of employee experience, engagement, inclusion, and leadership practices using defined workplace standards.
                        </p>
                    </div>
                    <div class="service-btn">
                        <a href="@Url.Action("Contact", "Contact")">Contact Us<i class="flaticon flaticon-right-arrow"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4">
                <div class="service-single-box three">
                    <div class="service-icon">
                        <img src="~/assets/images/inner-img/serv-icon3.png" alt="icon">
                    </div>
                    <div class="service-content">
                        <h3>Employer Recognition</h3>
                        <p>
                            Official recognition and certification badges that help organizations strengthen employer branding and workplace credibility.
                        </p>
                    </div>
                    <div class="service-btn">
                        <a href="@Url.Action("Contact", "Contact")">Contact Us<i class="flaticon flaticon-right-arrow"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4">
                <div class="service-single-box four">
                    <div class="service-icon">
                        <img src="~/assets/images/inner-img/serv-icon4.png" alt="icon">
                    </div>
                    <div class="service-content">
                        <h3>Workplace Awards</h3>
                        <p>
                            Recognition programs that honor organizations demonstrating excellence in workplace culture, values, and employee well-being.
                        </p>
                    </div>
                    <div class="service-btn">
                        <a href="@Url.Action("Contact", "Contact")">Contact Us<i class="flaticon flaticon-right-arrow"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--==================================================-->
<!-- End roadly service section inner style-->
<!--==================================================-->
<!--==================================================-->
<!-- Start roadly work Area -->
<!--==================================================-->
<section class="work_area inner-style">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon.png" alt="work-icon">
                            <span class="work-number">01</span>
                        </div>
                        <h3 class="work-title">Patching Planning</h3>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon2.png" alt="work-icon">
                            <span class="work-number">02</span>
                        </div>
                        <h3 class="work-title">Detailed Proposal</h3>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon3.png" alt="work-icon">
                            <span class="work-number">03</span>
                        </div>
                        <h3 class="work-title">Road Installation</h3>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="work-single-box style-foure">
                    <div class="work-content">
                        <div class="work-icon">
                            <img src="~/assets/images/home_one/work-icon4.png" alt="work-icon">
                            <span class="work-number">04</span>
                        </div>
                        <h3 class="work-title">Finished Road</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--==================================================-->
<!-- End roadly work Area-->
<!--==================================================-->


