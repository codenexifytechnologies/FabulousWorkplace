
@{
    ViewBag.Title = "PrivacyPolicy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="breadcumb-area d-flex style_two">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <div class="breadcumb-title">
                        <h4>Privacy & Policy</h4>
                    </div>
                    <ul>
                        <li><a href="@Url.Action("PrivacyPolicy", "PrivacyPolicy")">Home <span>/</span></a></li>
                        <li class="breadcumb-intext">Privacy & Policy</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="breadcumb-shape">
            <img src="~/assets/images/inner-img/breadcumb-dot.png" alt="dot">
        </div>
    </div>
</div>

<section class="choose_area">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <div class="section_title style_three text-center">
                    <h2>Privacy & Policy</h2>
                    <h4>Effective Date : 16 Dec 2025</h4>
                    <p> Fabulous Workplace respects your privacy and is committed to protecting the personal and organizational information you share with us.</p>
                </div>
            </div>
        </div>

        <div class="expert-title">
            <h2>Information We Collect</h2>
        </div>
        <div class="expert-desc">
            <p>
                We may collect information such as:
            </p>
            <p>
                # Organization name, contact details, and business information
            </p>
            <p># Personal details of authorized representatives</p>
            <p># Information submitted during certification or inquiry processes</p>
            <p># Website usage data (cookies, analytics)</p>
        </div>


        <div class="expert-title">
            <h2>How We Use Information</h2>
        </div>
        <div class="expert-desc">
            <p>
                Information is used to:
            </p>
            <p>
                # Process certification applications
            </p>
            <p># Communicate regarding services and updates</p>
            <p># Improve our website and offerings</p>
            <p># Maintain records and compliance</p>
        </div>

        <div class="expert-title">
            <h2>Data Protection</h2>
        </div>
        <div class="expert-desc">
            <p>
                We implement reasonable administrative and technical safeguards to protect your data against unauthorized access, misuse, or disclosure.
            </p>
        </div>

        <div class="expert-title">
            <h2>Information Sharing</h2>
        </div>
        <div class="expert-desc">
            <p>
                We do not sell or rent personal information. Data may be shared only when required by law or for certification-related processes with confidentiality maintained.
            </p>
        </div>


        <div class="expert-title">
            <h2>Cookies</h2>
        </div>
        <div class="expert-desc">
            <p>
                Our website may use cookies to enhance user experience and analyze site performance.
            </p>
        </div>

        <div class="expert-title">
            <h2>Your Rights</h2>
        </div>
        <div class="expert-desc">
            <p>
                You may request access, correction, or deletion of your information by contacting us.
            </p>
        </div>


    </div>
</section>
