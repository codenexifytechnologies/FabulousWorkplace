<!-- Start roadly About Area style-one -->
<!--==================================================-->
<section class="about_area style-one">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 col-md-7 col-sm-7">
                <div class="about_content">
                    <!-- section title -->
                    <div class="section_title text-left">
                        <h4 class="style-tow">About Fabulous Workplace </h4>
                        <h1>How Workplace Culture <br> Shapes <span>Our Organizations</span></h1>
                        <p>
                            Fabulous Workplace recognizes organizations that build strong, people-focused cultures through trust, engagement, and ethical leadership. Our certification highlights workplaces where employees feel valued and empowered.
                        </p>
                    </div>
                </div>
                <div class="row list-box">
                    <div class="col-lg-6 col-md-6">
                        <div class="icon-list-box">
                            <ul>
                                <li><i class="bi bi-chevron-double-right"></i>Trusted Certification Standards</li>
                                <li><i class="bi bi-chevron-double-right"></i>Experienced Assessment Professionals</li>
                                <li><i class="bi bi-chevron-double-right"></i>Recognized Workplace Excellence</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="icon-list-box style-tow">
                            <ul>
                                <li><i class="bi bi-chevron-double-right"></i>Independent Evaluation Process</li>
                                <li><i class="bi bi-chevron-double-right"></i>Transparent Certification Framework</li>
                                <li><i class="bi bi-chevron-double-right"></i>Multi-Industry Coverage</li>
                            </ul>
                        </div>
                    </div>
                </div>
                @*<div class="roadly_btn">
                    <a href="about.html">Diacover More <i class="flaticon flaticon-right-arrow"></i><span></span></a>
                </div>*@
            </div>
            <div class="col-lg-5 col-md-5 col-sm-5">
                <div class="about_thumb">
                    <div class="about_thumb_inner">
                        <img src="~/assets/images/home_one/about-thumb.png" alt="about-thumb">
                        <div class="about-shape">
                            <img src="~/assets/images/home_one/about-shape.png" alt="about-shape">
                        </div>
                        <div class="about-coun-box">
                            <span class="coun-number">15+</span>
                            <h3 class="coun-title">YEARS <br>OF EXPERIENCE</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
